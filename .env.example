# Copy this file to .env, then replace every CHANGE_ME value before starting.
# Generate secrets with: openssl rand -base64 32
#
# Used by: docker-compose.yaml (published image) and local compose.yaml (build).
#
# Quick start (no clone):
#   curl -fsSLO https://raw.githubusercontent.com/rzarajczyk/ownkeep-core/main/docker-compose.yaml
#   curl -fsSLO https://raw.githubusercontent.com/rzarajczyk/ownkeep-core/main/.env.example
#   cp .env.example .env   # then edit
#   docker compose up -d

OWNKEEP_PORT=8080

# --- Postgres (single URL — paste Neon "connection string" as-is) ---
# Local Compose: host must be "db". Quote the value if the URL contains & (Neon).
OWNKEEP_DATABASE_URL='postgresql://ownkeep:CHANGE_ME_use_a_unique_random_database_password@db:5432/ownkeep'
# Neon example (paste the console connection string as-is, in single quotes):
# OWNKEEP_DATABASE_URL='postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# Bootstrap first admin only; afterwards manage users in the app.
# Admin identity must be a valid email (verification is never required for the bootstrap admin).
# Keep these on one line. Single quotes preserve literal '$' in passwords.
OWNKEEP_ADMIN_EMAIL=admin@example.com
OWNKEEP_ADMIN_PASSWORD=CHANGE_ME_use_a_long_unique_admin_password

# ISO-8601 duration (for example PT12H or P7D).
OWNKEEP_TOKEN_TTL=PT24H
# Soft-deleted accounts are permanently purged after this retention period.
# OWNKEEP_DELETED_USER_RETENTION=60d
# Note revisions and soft-deleted attachment blobs are retained for this period.
# OWNKEEP_NOTE_REVISION_RETENTION=30d

# Optional email verification for non-admin users (default: disabled).
# When true, OWNKEEP_PUBLIC_BASE_URL and SMTP settings below are required.
OWNKEEP_EMAIL_VERIFICATION_REQUIRED=false
# OWNKEEP_PUBLIC_BASE_URL=https://notes.example.com
# OWNKEEP_MAIL_HOST=smtp.example.com
# OWNKEEP_MAIL_PORT=587
# OWNKEEP_MAIL_USERNAME=
# OWNKEEP_MAIL_PASSWORD=
# OWNKEEP_MAIL_SMTP_AUTH=true
# OWNKEEP_MAIL_STARTTLS=true
# OWNKEEP_MAIL_FROM=OwnKeep <noreply@example.com>

# Attachments: 25 MiB per file, 26 MiB multipart ceiling, 1 GiB per-user quota.
OWNKEEP_ATTACHMENT_MAX_FILE_SIZE=26214400
OWNKEEP_MULTIPART_MAX_REQUEST_SIZE=27262976
OWNKEEP_ATTACHMENT_PER_USER_QUOTA=1073741824

# Attachment blob backend: filesystem (default) or gcs.
# OWNKEEP_ATTACHMENT_STORAGE=filesystem
# OWNKEEP_ATTACHMENT_STORAGE_ROOT=./data/attachments
# OWNKEEP_ATTACHMENT_STORAGE=gcs
# OWNKEEP_ATTACHMENT_GCS_BUCKET=your-bucket-name
# OWNKEEP_ATTACHMENT_GCS_PREFIX=ownkeep/
